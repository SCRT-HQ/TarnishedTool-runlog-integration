<UserControl x:Class="TarnishedTool.Views.Tabs.ControlTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="600">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap"
                       Text="Connect to a WebSocket server and let it change the game while you play: Streamer.bot for your chat and channel points, a Runlog run for the dice at the table, or anything of your own." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Address" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,8,4" />
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="Connect" Command="{Binding ConnectCommand}" Width="90" Margin="0,0,4,0" />
                <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Width="90" />
            </StackPanel>

            <!-- Across both columns, so the right one stays the width of its two buttons and the address keeps the rest. -->
            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Connect on start"
                          IsChecked="{Binding ConnectOnStart}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0" />
                <CheckBox Content="Relay deaths to server"
                          IsChecked="{Binding TellsOfDeath}"
                          VerticalAlignment="Center"
                          ToolTip="Sends a death event to the connected server over the open socket each time the player dies. The server decides what to do with it; nothing else is sent." />
                <CheckBox Content="Show server effect notifications"
                          IsChecked="{Binding SaysInGame}"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0"
                          ToolTip="Shows an in-game status message, using the effect's label, when a server-applied effect is applied or removed. Only effects with no visible feedback of their own are announced: flags, values and special effects. Item, rune and warp operations are not." />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Status: " />
            <TextBlock Text="{Binding Status}" FontWeight="Bold" Margin="0,0,16,0" />
            <TextBlock Text="In force: " />
            <TextBlock Text="{Binding LiveCount}" FontWeight="Bold" Margin="0,0,16,0" />
            <Button Content="Remove applied effects"
                    Command="{Binding TakeEverythingOffCommand}"
                    ToolTip="Reverts every effect the server still holds in force: flags and values go back to their previous settings, applied special effects are removed, and watches stop. Items, runes, warps and button presses are one-way and are not undone."
                    Width="170" />
        </StackPanel>

        <!-- Side by side: the operation list is narrow and tall, the log wide and tall. -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Source actions" VerticalAlignment="Center" Margin="0,0,0,5" />
        <ListBox Grid.Row="1" Grid.Column="0"
                 Margin="0,0,10,0"
                 ItemsSource="{Binding Operations}"
                 BorderThickness="1"
                 BorderBrush="#333"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="Transparent" Padding="8,3">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsAllowed}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,5" LastChildFill="False">
            <TextBlock Text="Connection log" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <Button DockPanel.Dock="Right"
                    Content="Clear"
                    Command="{Binding ClearLogCommand}"
                    ToolTip="Empties the connection log. Nothing applied is affected."
                    Width="60"
                    Margin="8,0,0,0" />
            <ComboBox DockPanel.Dock="Right"
                      Width="110"
                      VerticalAlignment="Center"
                      ToolTip="How much the log records. Quiet: errors and refusals only. Normal: also each effect applied or removed. Everything: also every operation as it runs, with its arguments."
                      ItemsSource="{Binding Chatters}"
                      SelectedItem="{Binding Chatter, Mode=TwoWay}" />
            <TextBlock DockPanel.Dock="Right"
                       Text="Verbosity"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       Foreground="#999" />
        </DockPanel>

        <ListBox Grid.Row="1" Grid.Column="1"
                 ItemsSource="{Binding Log}"
                 BorderThickness="1"
                 BorderBrush="#333"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="Transparent" Padding="6,2">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
    </Grid>
</UserControl>
